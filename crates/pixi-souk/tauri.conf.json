{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixi Souk",
  "identifier": "dev.prefix.pixi-souk",
  "build": {
    "beforeDevCommand": "pnpm --filter pixi-souk dev",
    "beforeBuildCommand": "pnpm --filter pixi-souk build",
    "devUrl": "http://localhost:5273",
    "frontendDist": "../../frontend/pixi-souk/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
