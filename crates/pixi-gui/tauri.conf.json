{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixi GUI",
  "identifier": "dev.prefix.pixi-gui",
  "build": {
    "beforeDevCommand": "pnpm --filter pixi-gui dev",
    "beforeBuildCommand": "pnpm --filter pixi-gui build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../frontend/pixi-gui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
